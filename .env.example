# Copy this file to .env and fill in your keys. Never commit .env.

# --- LLM provider (choose one) ---
# Groq free tier: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter free tier (alternative): https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Embeddings ---
# Default is a free local model (no key needed).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_DIR=.chroma
CHROMA_COLLECTION=policies

# --- Retrieval / generation params ---
TOP_K=4
MAX_OUTPUT_TOKENS=512

# --- Reproducibility ---
SEED=42
